[Unit]
Description=andybioticlaw — daily SQLite backup

[Timer]
# Fires every day at ~03:15 local time. Persistent=true means a run is
# triggered immediately if the VPS was off when the timer should have fired.
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=15m
Persistent=true
Unit=andybioticlaw-backup.service

[Install]
WantedBy=timers.target
