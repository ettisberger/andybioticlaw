[Unit]
Description=andybioticlaw — personal AI agent service
Documentation=https://github.com/ettisberger/andybioticlaw
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=andybioticlaw
Group=andybioticlaw

# Absolute path to the deployed install. Rendered by scripts/install.sh
# (replaces __INSTALL_DIR__ with the chosen install root before copying
# the file into /etc/systemd/system/).
WorkingDirectory=__INSTALL_DIR__
ExecStart=/usr/bin/env node __INSTALL_DIR__/dist/index.js
ExecReload=/bin/kill -HUP $MAINPID

# Restart + startup-limit posture per spec.
Restart=on-failure
RestartSec=5
StartLimitInterval=300
StartLimitBurst=3

# Graceful shutdown: spec allows up to 30s for in-flight sessions to finish.
KillSignal=SIGTERM
TimeoutStopSec=35
SendSIGKILL=yes

# Environment
Environment=NODE_ENV=production
# Claude CLI typically installs to ~/.local/bin/claude (per `curl -fsSL
# https://claude.ai/install.sh | bash`). systemd's default PATH does
# NOT include user-local bins, so `claude auth status` would silently
# fail with empty stdout. Append the per-user shim dirs explicitly.
Environment=PATH=__SERVICE_HOME__/.local/bin:__SERVICE_HOME__/.claude/local:/usr/local/bin:/usr/bin:/bin
# The service reads its `.env` file via src/config/load.ts; no EnvironmentFile= needed.

# Sandboxing (Linux-only; ignored on development macOS).
ProtectSystem=strict
ProtectHome=read-only
# Data dir for SQLite, logs, session workspaces.
ReadWritePaths=__INSTALL_DIR__/data
# Claude CLI's subscription-token cache — the CLI periodically refreshes
# the OAuth token in-place, which fails under ProtectHome=read-only
# without this exception.
ReadWritePaths=__SERVICE_HOME__/.claude
# Claude CLI also writes a top-level `~/.claude.json` (project config +
# session metadata) alongside the .claude/ dir. Without this exception
# every memory/note/etc. write fails with EROFS when the CLI tries to
# update its own state file.
ReadWritePaths=__SERVICE_HOME__/.claude.json
# Claude CLI's HTTP / tmp cache (XDG default). Without this, live sessions
# fail with a generic "result event marked as error" and 0 tokens in/out.
ReadWritePaths=__SERVICE_HOME__/.cache
PrivateTmp=yes
NoNewPrivileges=yes

# Logging to journald; our pino logger ALSO writes data/logs/andybioticlaw.log.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
