{
  "name": "andybioticlaw",
  "version": "0.17.1",
  "private": true,
  "description": "Personal AI agent service — Telegram frontend, Claude CLI backend, SQLite persistence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ettisberger/andybioticlaw.git"
  },
  "homepage": "https://github.com/ettisberger/andybioticlaw#readme",
  "bugs": {
    "url": "https://github.com/ettisberger/andybioticlaw/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "andybioticlaw": "./dist/cli/admin.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli/admin.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.2.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.5.0",
    "commander": "^14.0.3",
    "fastify": "^5.8.5",
    "grammy": "^1.42.0",
    "js-yaml": "^4.1.0",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^10.2.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "argon2"
    ]
  }
}
