# --- Dependencies ---------------------------------------------------------
node_modules/
.pnpm-store/

# --- Build output ---------------------------------------------------------
dist/
*.tsbuildinfo

# --- Runtime data (SQLite DB, logs, per-session workspaces) ---------------
# The service creates data/ subdirs at boot via ensureDir(); nothing here
# should ever be committed.
data/

# --- Secrets --------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# --- Local config overrides -----------------------------------------------
# config.example.yaml is the canonical shape; config.yaml is the local copy
# and may contain Telegram user ids, API paths, etc.
config/config.yaml
config/config.local.yaml

# --- Local Claude Code settings (per-machine) -----------------------------
.claude/

# --- Editor / IDE ---------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig

# --- OS junk --------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Logs anywhere --------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*

# --- Release artifacts ----------------------------------------------------
*.tgz
*.tar.gz
release/

# --- Test artifacts -------------------------------------------------------
coverage/
.vitest-cache/
