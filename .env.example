# --- Core secrets ---------------------------------------------------------
# These are the only secrets the core service is permitted to read.
# Skill-specific secrets are declared in each skill's manifest.yaml under
# `required_secrets` and scoped accordingly.
#
# The dashboard's basic-auth password is NOT stored here — it's argon2-
# hashed by `andybioticlaw init` and written into config.yaml under
# `dashboard.basicAuth.passwordHash`. No plain password is kept anywhere.

TELEGRAM_BOT_TOKEN=

# Optional. If set, the `claude` CLI uses this long-lived OAuth token
# (from `claude setup-token`) instead of the interactive keyring session
# created by `claude login`. Tokens are subscription-billed (Pro/Max/Team/
# Enterprise), NOT pay-as-you-go — they use the same quota as a session.
# Format: `sk-ant-oat-...`, 1-year lifetime. Useful for unattended VPS
# installs where no one is around to re-run `claude login` every few
# months. See README § "Subscription auth is enforced at three layers".
CLAUDE_CODE_OAUTH_TOKEN=


# --- Skill secrets (example — uncomment per-skill as needed) --------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# PHILIPS_HUE_BRIDGE_IP=
# PHILIPS_HUE_API_KEY=
# NOTION_API_KEY=
