# --- Core secrets ---------------------------------------------------------
# These are the only secrets the core service is permitted to read.
# Skill-specific secrets are declared in each skill's manifest.yaml under
# `required_secrets` and scoped accordingly.
#
# The dashboard's basic-auth password is NOT stored here — it's argon2-
# hashed by `andybioticlaw init` and written into config.yaml under
# `dashboard.basicAuth.passwordHash`. No plain password is kept anywhere.

TELEGRAM_BOT_TOKEN=


# --- Skill secrets (example — uncomment per-skill as needed) --------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# PHILIPS_HUE_BRIDGE_IP=
# PHILIPS_HUE_API_KEY=
# NOTION_API_KEY=
